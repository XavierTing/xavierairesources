{
  // Cloudflare Workers static-asset hosting for xaviertingai.com.
  // The site has no build step: the repo root IS the deployable directory,
  // so `directory` is "." and .assetsignore carves out everything that is
  // source, tooling or documentation rather than something a browser asks for.
  "name": "xaviertingai",
  "compatibility_date": "2026-08-14",

  // The one piece of Worker code: it 301s www.xaviertingai.com to the apex
  // and hands every other request to the static assets untouched. It exists
  // because a redirect needs something answering on www, and this keeps that
  // answer in the repo instead of in a dashboard rule nobody can review.
  "main": "worker.js",

  // The site is reachable only at its custom domain. Turning this on would
  // publish a second, identical copy at <name>.<subdomain>.workers.dev, which
  // means a rival address for search engines to index and a first deploy that
  // fails until the account registers an account-wide workers.dev subdomain.
  "workers_dev": false,

  "assets": {
    "directory": ".",

    // Every internal link, every sitemap entry and every canonical tag on this
    // site ends in .html. The default ("auto-trailing-slash") 307-redirects
    // /ai-101.html to /ai-101, which would bounce every link the site ships and
    // every URL already indexed. "none" serves the exact path that was asked
    // for, which is what Netlify did.
    "html_handling": "none",

    // A miss serves 404.html with a real 404 status, instead of the blank
    // zero-byte response "none" produced. Old Netlify-era link shapes
    // (extensionless /tools/context7) land somewhere human now.
    "not_found_handling": "404-page",

    // How worker.js reaches the assets for everything that is not www.
    "binding": "ASSETS",

    // Without this, any request whose path matches an existing file is served
    // straight from assets and worker.js never runs, so www would serve a
    // duplicate of the site instead of redirecting.
    "run_worker_first": true
  },

  "routes": [
    // Requires the xaviertingai.com zone to be active on Cloudflare first.
    // Attaching www as a custom domain makes the deploy create its DNS record
    // and certificate; worker.js then 301s it to the apex, so the site is
    // still never served from two hostnames at once.
    { "pattern": "xaviertingai.com", "custom_domain": true },
    { "pattern": "www.xaviertingai.com", "custom_domain": true }
  ]
}
